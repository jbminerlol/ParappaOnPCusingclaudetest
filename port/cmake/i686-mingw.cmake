# 32-bit Windows toolchain (llvm-mingw). The port must be 32-bit: PS1 pointers are used as-is.
# llvm-mingw and the SDL3 MinGW development package are found in <repo>/tools (or PARAPPA_TOOLS),
# or given directly with -DLLVM_MINGW=... -DSDL3_DIR=... (or the environment variables of the same names).
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR i686)

get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(_tools "${_root}/tools")
if(DEFINED ENV{PARAPPA_TOOLS})
    set(_tools "$ENV{PARAPPA_TOOLS}")
endif()

if(NOT LLVM_MINGW AND DEFINED ENV{LLVM_MINGW})
    set(LLVM_MINGW "$ENV{LLVM_MINGW}")
endif()
if(NOT LLVM_MINGW)
    file(GLOB _found LIST_DIRECTORIES true "${_tools}/llvm-mingw-*")
    list(SORT _found)
    list(REVERSE _found)
    list(GET _found 0 LLVM_MINGW)
endif()
set(LLVM_MINGW "${LLVM_MINGW}" CACHE PATH "llvm-mingw toolchain")

file(GLOB _sdl LIST_DIRECTORIES true "${_tools}/SDL3-*")
list(SORT _sdl)
list(REVERSE _sdl)
if(_sdl)
    list(GET _sdl 0 _sdl_root)
endif()
if(NOT SDL3_DIR AND DEFINED ENV{SDL3_DIR})
    set(SDL3_DIR "$ENV{SDL3_DIR}")
endif()
if(NOT SDL3_DIR AND _sdl_root)
    set(SDL3_DIR "${_sdl_root}/i686-w64-mingw32/lib/cmake/SDL3")
endif()
set(SDL3_DIR "${SDL3_DIR}" CACHE PATH "SDL3 package (i686-w64-mingw32/lib/cmake/SDL3 of the MinGW development release)")

set(CMAKE_C_COMPILER "${LLVM_MINGW}/bin/i686-w64-mingw32-clang.exe")
set(CMAKE_CXX_COMPILER "${LLVM_MINGW}/bin/i686-w64-mingw32-clang++.exe")
set(CMAKE_RC_COMPILER "${LLVM_MINGW}/bin/i686-w64-mingw32-windres.exe")
get_filename_component(_sdl_prefix "${SDL3_DIR}/../../.." ABSOLUTE)
set(CMAKE_FIND_ROOT_PATH "${LLVM_MINGW}/i686-w64-mingw32" "${_sdl_prefix}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
